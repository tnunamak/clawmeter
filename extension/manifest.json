{
  "manifest_version": 3,
  "name": "Clawmeter",
  "version": "0.1.0",
  "description": "Claude reset grants and Claude/OpenAI API credits in Clawmeter.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://platform.claude.com/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://platform.openai.com/*"],
  "key": "",
  "action": {
    "default_title": "Clawmeter",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
