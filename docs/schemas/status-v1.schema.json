{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tnunamak/clawmeter/main/docs/schemas/status-v1.schema.json",
  "title": "Clawmeter status v1",
  "type": "object",
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": { "const": 1 },
    "error": { "type": "string" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "providers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/provider" } },
    "cache": {
      "type": "object",
      "required": ["hit"],
      "properties": {
        "hit": { "type": "boolean" },
        "fetched_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "view": { "$ref": "#/$defs/view" }
  },
  "additionalProperties": true,
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["maturity"],
      "properties": {
        "maturity": {
          "type": "object",
          "required": ["experimental"],
          "properties": {
            "experimental": { "type": "boolean" },
            "learn_more": { "type": "string", "format": "uri" }
          },
          "additionalProperties": true
        },
        "usage": { "$ref": "#/$defs/usage" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "forecast": {
          "type": "object",
          "required": ["windows"],
          "properties": {
            "windows": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["projected_pct", "indicator"],
                "properties": {
                  "projected_pct": { "type": "number" },
                  "indicator": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "status": { "type": "object" },
        "view": { "$ref": "#/$defs/account_view" }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" }, "label": { "type": "string" } },
          "additionalProperties": false
        },
        "usage": { "$ref": "#/$defs/usage" },
        "forecast": { "$ref": "#/$defs/provider/properties/forecast" },
        "status": { "type": "object" },
        "view": { "$ref": "#/$defs/account_view" }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": ["provider", "fetched_at", "windows"],
      "properties": {
        "provider": { "type": "string" },
        "source_id": { "type": "string" },
        "source_label": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "windows": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["name", "utilization", "resets_at"],
            "properties": {
              "name": { "type": "string" },
              "display_name": { "type": "string" },
              "utilization": { "type": "number" },
              "resets_at": { "type": "string", "format": "date-time" },
              "reset_policy": { "type": "string" },
              "scope": { "type": "string" },
              "description": { "type": "string" },
              "currency": { "type": "string" },
              "window_length_seconds": { "type": "number" },
              "limit": { "type": "integer" },
              "used": { "type": "integer" },
              "window_length_unknown": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "error": { "type": "string" },
        "stale": { "type": "boolean" },
        "warning": { "type": "string" },
        "is_expired": { "type": "boolean" },
        "reset_credits_target": { "type": "string" },
        "balances": { "type": "array", "items": { "$ref": "#/$defs/usage_balance" } },
        "announced_reset": { "$ref": "#/$defs/announced_reset" },
        "credit_grants": { "type": "array", "items": { "$ref": "#/$defs/credit_grant" } },
        "credit_benefits": { "type": "array", "items": { "$ref": "#/$defs/credit_benefit" } },
        "local_models": { "type": "array", "items": { "$ref": "#/$defs/local_model" } },
        "api_credit_balances": { "type": "array", "items": { "$ref": "#/$defs/api_credit_balance" } },
        "credit_pools": { "type": "array", "items": { "$ref": "#/$defs/credit_pool" } },
        "reset_credits": {
          "type": "object",
          "required": ["available_count"],
          "properties": {
            "available_count": { "type": "integer", "minimum": 0 },
            "fetched_at": { "type": "string", "format": "date-time" },
            "warning": { "type": "string" },
            "snapshot": { "type": "boolean" },
            "earliest_expires_at": { "type": "string", "format": "date-time" },
            "credits": { "type": "array", "items": { "$ref": "#/$defs/reset_credit" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "view": {
      "description": "Added in v1 as an optional field. The snapshot the output was built from: one clock, the account order, and the most at-risk window.",
      "type": "object",
      "required": ["at"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "accounts": {
          "type": "array",
          "description": "Source keys in snapshot display order.",
          "items": { "type": "string" }
        },
        "worst": {
          "type": "object",
          "required": ["account", "window"],
          "properties": {
            "account": { "type": "string" },
            "window": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "account_view": {
      "description": "One source's snapshot. Keys are absent when their value is unknown; they are never zero.",
      "type": "object",
      "required": ["reading", "windows"],
      "properties": {
        "credit_grants": { "type": "array", "items": { "$ref": "#/$defs/credit_grant_view" } },
        "credit_benefits": { "type": "array", "items": { "$ref": "#/$defs/credit_benefit_view" } },
        "api_credit_balances": { "type": "array", "items": { "$ref": "#/$defs/api_credit_balance_view" } },
        "local_models": { "type": "array", "items": { "$ref": "#/$defs/local_model" } },
        "local_model_status": { "$ref": "#/$defs/local_model_status" },
        "reading": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["fresh", "stale", "error", "expired", "unavailable"] },
            "observed_at": { "type": "string", "format": "date-time" },
            "reason": { "type": "string" }
          },
          "additionalProperties": true
        },
        "windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/window_view" }
        }
      },
      "additionalProperties": true
    },
    "window_view": {
      "type": "object",
      "required": ["name", "used", "shown", "forecast", "exhaustion", "reset"],
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "label": { "type": "string" },
        "used": { "type": "number" },
        "shown": { "type": "boolean", "description": "Whether list surfaces show this window to people." },
        "forecast": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "basis": { "type": "string", "enum": ["average_since_reset"] },
            "state": { "enum": ["known", "warming", "stale", "pending", "none"] },
            "pct": { "type": "number" }
          },
          "if": { "properties": { "state": { "const": "known" } }, "required": ["state"] },
          "then": { "required": ["pct"] },
          "else": { "not": { "required": ["pct"] } },
          "additionalProperties": true
        },
        "exhaustion": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["out", "runs_out", "lasts", "unknown"] },
            "runs_out_in_seconds": { "type": "integer", "minimum": 0 },
            "early_by_seconds": { "type": "integer", "minimum": 0 },
            "out_since": { "type": "string", "format": "date-time" }
          },
          "if": { "properties": { "state": { "const": "runs_out" } }, "required": ["state"] },
          "then": { "required": ["runs_out_in_seconds"] },
          "else": { "not": { "required": ["runs_out_in_seconds"] } },
          "additionalProperties": true
        },
        "reset": {
          "type": "object",
          "required": ["known"],
          "properties": {
            "known": { "type": "boolean" },
            "at": { "type": "string", "format": "date-time" },
            "policy": { "type": "string" }
          },
          "if": { "properties": { "known": { "const": true } }, "required": ["known"] },
          "then": { "required": ["at"] },
          "else": { "not": { "required": ["at"] } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "reset_credit": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "consumed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "usage_balance": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "display_name": { "type": "string" },
        "total": { "type": "number" },
        "used": { "type": "number" },
        "remaining": { "type": "number" }
      },
      "additionalProperties": true
    },
    "announced_reset": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "feed": { "type": "string" },
        "source_url": { "type": "string" },
        "official": { "type": "boolean" },
        "approximate": { "type": "boolean" },
        "announced_at": { "type": "string", "format": "date-time" },
        "scheduled_for": { "type": "string", "format": "date-time" },
        "feed_checked_at": { "type": "string", "format": "date-time" },
        "shown_until": { "type": "string", "format": "date-time" },
        "windows": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "credit_grant": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "display_name": { "type": "string" },
        "scope": { "type": "string" },
        "currency": { "type": "string" },
        "used": { "type": "number" },
        "limit": { "type": "number" },
        "utilization": { "type": "number" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "credit_benefit": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "pool": { "type": "string" },
        "eligibility": { "type": "string" },
        "link_state": { "type": "string" },
        "currency": { "type": "string" },
        "cadence": { "type": "string" },
        "claimable": { "type": "integer" },
        "period_credit": { "type": "integer" },
        "link_observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "local_model": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "label": { "type": "string" },
        "day_utc": { "type": "string" },
        "assistant_messages": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "reasoning_tokens": { "type": "integer" },
        "cache_read_tokens": { "type": "integer" },
        "cache_write_tokens": { "type": "integer" },
        "limit_hit_at": { "type": "string", "format": "date-time" },
        "retry_hint_at": { "type": "string", "format": "date-time" },
        "reset_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "api_credit_balance": {
      "type": "object",
      "properties": {
        "pool": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "balance": { "type": "integer" },
        "observed_at": { "type": "string", "format": "date-time" },
        "grants": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/api_credit_expiry" }
        }
      },
      "additionalProperties": true
    },
    "api_credit_expiry": {
      "type": "object",
      "properties": {
        "remaining": { "type": "integer" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "credit_pool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "organization": { "type": "string" },
        "claude_source": { "type": "string" },
        "plan": { "type": "string" },
        "currency": { "type": "string" },
        "observation_source": { "type": "string" },
        "burn_per_day": { "type": "number" },
        "monthly_credit": { "type": "integer" },
        "balance": { "type": "integer" },
        "month_spend": { "type": "integer" },
        "expiring": { "type": "integer" },
        "burn_days": { "type": "integer" },
        "projected_spend_before_expiry": { "type": "integer" },
        "projected_unused_at_expiry": { "type": "integer" },
        "live": { "type": "boolean" },
        "signed_out": { "type": "boolean" },
        "month_resets_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "observed_at": { "type": "string", "format": "date-time" },
        "extension_contact_at": { "type": "string", "format": "date-time" },
        "runs_out_at": { "type": "string", "format": "date-time" },
        "next_credit_at": { "type": "string", "format": "date-time" },
        "expired_since_check": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "credit_grant_view": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "scope": { "type": "string" },
        "currency": { "type": "string" },
        "used": { "type": "number" },
        "limit": { "type": "number" },
        "remaining": { "type": "number" },
        "last_observed_remaining": { "type": "number" },
        "utilization": { "type": "number" },
        "expires_at": { "type": "string", "format": "date-time" },
        "state": { "type": "string", "enum": ["unknown", "available", "depleted", "stale", "expired"] }
      },
      "additionalProperties": true
    },
    "credit_benefit_view": {
      "allOf": [
        { "$ref": "#/$defs/credit_benefit" },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "enum": ["linked", "unknown", "stale", "ineligible", "expired", "claimable"] },
            "text": { "type": "string" },
            "action_url": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "api_credit_balance_view": {
      "allOf": [
        { "$ref": "#/$defs/api_credit_balance" },
        {
          "type": "object",
          "properties": {
            "state": { "type": "string", "enum": ["expired_since_check", "stale", "current"] },
            "available": { "type": "integer" },
            "text": { "type": "string" },
            "action_url": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "local_model_status": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "latest_limit_model": { "type": "string" },
        "latest_limit_label": { "type": "string" },
        "remaining_quota_known": { "type": "boolean" },
        "reset_known": { "type": "boolean" },
        "latest_limit_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
